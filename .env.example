PUBLIC_API_URL=http://localhost:8000/api
PUBLIC_ALLOW_REGISTRATION=true

# Fake-API (MSW) im Dev-Build. true/unset = Mocks aktiv, false = echtes Backend unter
# PUBLIC_API_URL/localhost:8000 nutzen. Siehe src/mocks/. Login-Fixture-User: siehe
# src/mocks/fixtures.ts, Passwort für alle: test1234
PUBLIC_USE_MOCKS=true
